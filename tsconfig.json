{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@enterprise/*": ["packages/*/src/index.ts"] }
  },
  "include": ["apps", "packages", "services", "scripts", "tests", "examples/agent.ts", "*.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
